    "dialoguePlan": {
      "lines": [
        { "lineId": "L-01", "speaker": "沈母", "text": "春日宴上，萧二公子与顾家那位说笑了三句，你可知？", "functions": ["deliver_info", "conflict_escalate"], "causedByActionId": "A1", "subtext": "问责" },
        { "lineId": "L-02", "speaker": "沈清瓷", "text": "女儿在场，萧公子只是应酬。", "functions": ["character_voice", "defense"], "causedByActionId": "A2", "subtext": "隐忍" },
        { "lineId": "L-03", "speaker": "沈母", "text": "应酬？若真是应酬，他为何不与你应酬？我供你吃穿，教你琴棋，不是为了让你当哑巴的。", "functions": ["conflict_escalate", "emotion_hit"], "causedByActionId": "A3", "subtext": "工具化" },
        { "lineId": "L-04", "speaker": "沈清瓷", "text": "母亲，若他根本无意于我，去再多又有何用？", "functions": ["character_voice", "conflict_escalate"], "causedByActionId": "A4", "subtext": "第一次质疑" },
        { "lineId": "L-05", "speaker": "沈母", "text": "无用？那你便跪到想通为止！", "functions": ["conflict_escalate", "emotion_hit"], "causedByActionId": "A5", "subtext": "彻底摊牌" },
        { "lineId": "L-06", "speaker": "沈清瓷", "text": "是谁……？", "functions": ["character_voice", "emotion_hit"], "causedByActionId": "A6", "subtext": "惊恐" },
        { "lineId": "L-07", "speaker": "沈青行", "text": "阿瓷？你怎么……", "functions": ["character_voice", "deliver_info"], "causedByActionId": "A7", "subtext": "关切" },
        { "lineId": "L-08", "speaker": "沈清瓷", "text": "没事，兄长。", "functions": ["character_voice", "defense"], "causedByActionId": "A8", "subtext": "隐瞒" },
        { "lineId": "L-09", "speaker": "沈青行", "text": "她又罚你了？", "functions": ["character_voice", "deliver_info"], "causedByActionId": "A9", "subtext": "心疼" },
        { "lineId": "L-10", "speaker": "沈清瓷", "text": "是我自己不好。", "functions": ["character_voice", "emotion_hit"], "causedByActionId": "A10", "subtext": "自贬" },
        { "lineId": "L-11", "speaker": "沈青行", "text": "阿瓷，兄长希望你能活得开心。", "functions": ["character_voice", "emotion_hit"], "causedByActionId": "A11", "subtext": "鼓励" },
        { "lineId": "L-12", "speaker": "沈清瓷", "text": "开心……？", "functions": ["character_voice", "emotion_hit"], "causedByActionId": "A12", "subtext": "茫然" },
        { "lineId": "L-13", "speaker": "沈母", "text": "萧家那边，递帖子了吗？", "functions": ["deliver_info", "conflict_escalate"], "causedByActionId": "A13", "subtext": "谋划" },
        { "lineId": "L-14", "speaker": "沈福", "text": "回主母，萧老夫人已应下春日宴，只待三日后。不过……萧二公子那边，似乎对顾家三小姐更热络些。", "functions": ["deliver_info"], "causedByActionId": "A14", "subtext": "汇报" },
        { "lineId": "L-15", "speaker": "沈母", "text": "顾云筝？一个庶出之女，也配与我沈家争？", "functions": ["character_voice", "conflict_escalate"], "causedByActionId": "A15", "subtext": "傲慢" },
        { "lineId": "L-16", "speaker": "沈福", "text": "主母，清瓷小姐到底不是您亲生的，萧家若查……", "functions": ["deliver_info", "conflict_escalate"], "causedByActionId": "A16", "subtext": "提醒" },
        { "lineId": "L-17", "speaker": "沈母", "text": "查什么查！我养她十八年，她就是沈家女！春日宴上，就算绑，也要把她绑到萧二公子面前。", "functions": ["conflict_escalate", "emotion_hit"], "causedByActionId": "A17", "subtext": "决绝" },
        { "lineId": "L-18", "speaker": "沈母", "text": "去，把清瓷的春日宴新衣备好——滚金边的，越扎眼越好。", "functions": ["deliver_info", "conflict_escalate"], "causedByActionId": "A18", "subtext": "物化" },
        { "lineId": "L-19", "speaker": "萧玄珩", "text": "三日后的春日宴……沈家那位，倒是有点意思。", "functions": ["character_voice", "conflict_escalate"], "causedByActionId": "A19", "subtext": "暗魂低语" },
        { "lineId": "L-20", "speaker": "影一", "text": "公子，沈家已回帖，沈清瓷列席。", "functions": ["deliver_info"], "causedByActionId": "A20", "subtext": "汇报" },
        { "lineId": "L-21", "speaker": "萧玄珩", "text": "知道了。退下。", "functions": ["character_voice"], "causedByActionId": "A21", "subtext": "清冷" },
        { "lineId": "L-22", "speaker": "萧玄珩", "text": "命书么……我倒要看看，你能改多少。", "functions": ["character_voice", "conflict_escalate"], "causedByActionId": "A22", "subtext": "暗魂玩味" },
        { "lineId": "L-23", "speaker": "冬青", "text": "小姐，主母差人送来了春日宴的新衣——滚金边鹅黄襦裙，说是让您明日试穿。", "functions": ["deliver_info"], "causedByActionId": "A23", "subtext": "传递" },
        { "lineId": "L-24", "speaker": "沈清瓷", "text": "若真如你所言，三日后拒婚……我该怎么办？", "functions": ["character_voice", "emotion_hit"], "causedByActionId": "A24", "subtext": "恐惧" },
        { "lineId": "L-25", "speaker": "沈清瓷", "text": "不，我不能坐以待毙。", "functions": ["character_voice", "conflict_escalate"], "causedByActionId": "A25", "subtext": "觉醒" },
        { "lineId": "L-26", "speaker": "沈清瓷", "text": "如果命轨真的能改……那第一件事，就是不去赴宴。", "functions": ["character_voice", "conflict_escalate"], "causedByActionId": "A26", "subtext": "计划" },
        { "lineId": "L-27", "speaker": "沈清瓷", "text": "去也是死，不去也是死……那我偏要走第三条路。", "functions": ["character_voice", "conflict_escalate"], "causedByActionId": "A27", "subtext": "决绝" },
        { "lineId": "L-28", "speaker": "沈清瓷", "text": "母亲说过，我是丹道传人。若我能炼出洗髓丹……萧家，沈家，谁都拦不住我。", "functions": ["character_voice", "emotion_hit"], "causedByActionId": "A28", "subtext": "希望" },
        { "lineId": "L-29", "speaker": "沈清瓷", "text": "这一世，我命由我。", "functions": ["character_voice", "emotion_hit"], "causedByActionId": "A29", "subtext": "最终宣示" }
      ]
    },
