{
  "version": "1.0.0",
  "doctrine": {
    "design": "strong_contract_DEX_BLOCK",
    "import": "safe_semantic_heal_then_gate",
    "preview": "layered_must_edit_vs_auto_adapt",
    "pillars": {
      "identity": ["DC-16", "DG-CD-COVERAGE", "DEX-CAST-CODES", "IMG-CREF-CHAR"],
      "duration": ["DFW-DURATION", "NAR-14", "NAR-15", "LIP-01"],
      "expression": ["GEN-01", "stillMouthVideoHandoff"]
    },
    "seeAlso": "docs/PRODUCTION_PILLARS.md"
  },
  "rows": [
    {
      "id": "DG-FALSE-GREEN-FX",
      "chatDex": "F0 declaration or fxPrompt prose",
      "ingestHeal": "gate accepts F0; fill fxFeasibility from visualEffect F0",
      "neverAuto": "invent F1+ fx prose"
    },
    {
      "id": "DFW-DURATION",
      "chatDex": "duration >= dialogue read time",
      "ingestHeal": "alignShotDurationFromDialogue + log",
      "neverAuto": null
    },
    {
      "id": "MOD-03",
      "chatDex": "audioPrompt when dialogue/audioCue",
      "ingestHeal": "compile from audioCue or dialogue summary",
      "neverAuto": "empty silent shots"
    },
    {
      "id": "MOD-IMG-M1",
      "chatDex": "imagePrompt required",
      "ingestHeal": "seed from visualDescription",
      "neverAuto": null
    },
    {
      "id": "MOD-VID-M1",
      "chatDex": "videoPrompt required",
      "ingestHeal": "seed from visualDescription + lip hint",
      "neverAuto": null
    },
    {
      "id": "TRANSITION",
      "chatDex": "whitelist transitionType",
      "ingestHeal": "illegal → alias/defaultTransition",
      "neverAuto": "forbidden motions"
    },
    {
      "id": "NAR-14",
      "chatDex": "prefer punctuation clause lines ≤15 chars; else splitHint+reaction △",
      "ingestHeal": "physical clause split SH-NAR-CLAUSE-SPLIT (plan+shots)",
      "neverAuto": "invent splitHint"
    },
    {
      "id": "NAR-15",
      "chatDex": "reactionAction on emotion_hit",
      "ingestHeal": "mirror only",
      "neverAuto": "invent reactionAction"
    },
    {
      "id": "DC-16",
      "chatDex": "B6 names in CD with L0.identity",
      "ingestHeal": "speaker stub still BLOCK until L0.identity; CHAR-ORPH free-NER strip auto_adapt (never invent orphan names as PASS)",
      "neverAuto": "stub as PASS; invent CD from visualDescription NER"
    },
    {
      "id": "PASTE-HYBRID",
      "chatDex": "export pure JSON only",
      "ingestHeal": "strip chatRepairText prefix before parse",
      "neverAuto": null
    },
    {
      "id": "SHAPE-B12-SPATIAL",
      "chatDex": "beats number; spatialRelation string",
      "ingestHeal": "SH-B12-BEATS / SH-SHOT-SPATIAL",
      "neverAuto": null
    },
    {
      "id": "RULEPACK",
      "chatDex": "rulePackVersion 2.1.0",
      "ingestHeal": null,
      "neverAuto": null
    },
    {
      "id": "DEX-VIS-SPLIT",
      "chatDex": "visualBeatTags × shotSize conflict_matrix → split or override",
      "ingestHeal": "expandVisualBeats soft_patch when auto_adapt",
      "neverAuto": "split from suggestor tags alone"
    },
    {
      "id": "DEX-VIS-TAG-MISSING",
      "chatDex": "L0 visualBeatTags required on SB shots with picture",
      "ingestHeal": "suggestor → suggestedTags only; confirm to L0",
      "neverAuto": "promote suggestedTags to L0 without confirm"
    },
    {
      "id": "DEX-VIS-TAG-INCONSISTENT",
      "chatDex": "tags require picture; no half-sets",
      "ingestHeal": "warn + RH",
      "neverAuto": null
    },
    {
      "id": "DEX-CAST-ON-DESC",
      "chatDex": "names in visualDescription ⊆ charCodes via CD map",
      "ingestHeal": "unique CD name→code when confidence≥threshold",
      "neverAuto": "ambiguous multi-CD match or invent CHAR"
    },
    {
      "id": "DEX-EMPTY-SHOT-CONSISTENCY",
      "chatDex": "empty-shot mark XOR face/name/codes",
      "ingestHeal": "strip conflicting empty-shot clauses only",
      "neverAuto": "invent establishing action"
    },
    {
      "id": "DEX-EXPR-SPEAK",
      "chatDex": "high-intensity speak requires microExpression+lipSyncPolicy",
      "ingestHeal": "low-intensity defaults only",
      "neverAuto": "high-intensity fake defaults"
    },
    {
      "id": "DEX-CUT-01",
      "chatDex": "adjacent scene/color/prop hard-cut WARN",
      "ingestHeal": null,
      "neverAuto": "invent transition prose"
    },
    {
      "id": "DEX-CAM-XSHOT",
      "chatDex": "adjacent motion/transition rhythm WARN",
      "ingestHeal": null,
      "neverAuto": "invent camera moves"
    },
    {
      "id": "DEX-STILL-ONEBEAT",
      "chatDex": "visualDescription 一镜一可静帧拍；多拍须 splitPlan/still_onebeat",
      "ingestHeal": "expandStillOneBeat when confidence≥0.7 + not chatStrict; else Confirm",
      "neverAuto": "trim 假绿 / soft_patch 顶拆 / 只 regen 脏首帧"
    },
    {
      "id": "DEX-STILL-CU-CAST",
      "chatDex": "特写/近景 × 出镜≥2 → must_split 反应特写+场面镜",
      "ingestHeal": "expandStillCuCast when deterministic + conf≥autoMin + not chatStrict; else Confirm; demoteAfterHeal",
      "neverAuto": "silent single_hero 洗绿 / 只 regen / 导入硬拦"
    },
    {
      "id": "VIS-MULTI-BEAT",
      "chatDex": "VisBeat tags×景别 conflict → expand or override",
      "ingestHeal": "runShotExpanders visual_multi when enforce",
      "neverAuto": "suggestor 静默立法拆镜"
    }
  ],
  "autoAdaptBlockIds": ["DFW-DURATION", "MOD-03", "MOD-IMG-M1", "MOD-VID-M1", "DG-SCENE-KEY", "CAM-SPEAK", "DEX-CAM-FIT"],
  "mustEditBlockIds": ["DEX-LITERARY-STALE", "NAR-15", "DC-16", "DG-CD-COVERAGE", "DG-FALSE-GREEN-FX", "DG-NAR-SELFCHECK", "DEX-VIS-TAG-MISSING", "DEX-VIS-TAG-INCONSISTENT", "DEX-VIS-SPLIT", "LIP-01", "DEX-LIP-SPLIT", "FX-GRADE-01", "DEX-CAST-ON-DESC", "DEX-EMPTY-SHOT-CONSISTENCY", "DEX-EXPR-SPEAK", "DEX-QP-02", "DEX-STILL-ONEBEAT", "DEX-STILL-CU-CAST", "DEX-STILL-OS-NAME", "DEX-STILL-FILLER", "VIS-MULTI-BEAT", "NO-LIP-DIALOGUE", "DESIGN-LOSS", "DUR-DESYNC", "PROMPT-FIDELITY", "DC-01-EXTRA", "CHAIN-BEAT", "CHAT-AUD-01", "IMPORT-SPLIT-SYNC", "AUD-ORPHAN-SPEECH", "DEX-INTENT-PIC", "IRD-CONFIRM", "DEX-DUP-VD", "DEX-DIRTY-STILL-PROMPT", "DEX-HAND-LIP"],
  "mustEditBlockIdsNote": "Chat/设计须重设计过检（不过绿）。导入：见 importSalvageRegistry.demoteAfterHeal — 智能愈后残留 soft 不硬拦；importOk≠designExitPass。DEX-DUP-VD/QP-02 仍禁 demote。",
