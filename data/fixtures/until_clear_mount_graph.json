    {
      "classId": "ACTION_MISFIRE",
      "handlerModule": "src/ruleEngine/quality/handlers/actionMisfireUntilClear.ts",
      "stages": ["compose_L0", "fidelity_L1", "burn_detect"],
      "healKinds": ["prompt_inject", "compose_regen", "regen"],
      "passKindsAllowed": ["measured_L1", "human", "unmeasured_no_hq"]
