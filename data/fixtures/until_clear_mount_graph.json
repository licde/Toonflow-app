      "handlerModule": "src/ruleEngine/quality/handlers/propInFrameUntilClear.ts",
      "stages": ["compose_L0", "fidelity_L1", "burn_detect"],
      "healKinds": ["prompt_inject", "fidelity_edit", "regen"],
      "passKindsAllowed": ["measured_L1", "human", "unmeasured_no_hq"]
