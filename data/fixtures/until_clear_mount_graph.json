      "stages": ["fidelity_L1", "burn_detect", "track_cascade"],
      "healKinds": ["cascade_burn"],
      "passKindsAllowed": ["measured_L1", "human"]
    },
    {
      "classId": "SPATIAL_LAYOUT",
