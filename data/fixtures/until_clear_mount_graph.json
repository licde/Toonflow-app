      "healKinds": ["prompt_inject", "soft_env_ref", "fidelity_edit", "regen"],
      "passKindsAllowed": ["measured_L1", "human", "unmeasured_no_hq"]
    },
    {
      "classId": "CONTACT_GEOM",
