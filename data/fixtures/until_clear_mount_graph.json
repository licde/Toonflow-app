{
  "version": "1.2.0",
  "description": "Live mount bindings for UntilClearRuntime — W1 + ACTION_MISFIRE",
  "phase1Classes": [
    "BG_READABLE",
    "CONTACT_GEOM",
    "STILL_HQ_EGRESS",
    "SPATIAL_LAYOUT",
    "PAPER_DOC_READABLE",
    "PROP_IN_FRAME",
    "PROMPT_FIDELITY",
    "IDENTITY_PLATE",
    "ACTION_MISFIRE",
    "SECONDARY_DOMINANCE"
  ],
  "bindings": [
    {
      "classId": "BG_READABLE",
      "handlerModule": "src/ruleEngine/quality/handlers/bgReadableUntilClear.ts",
