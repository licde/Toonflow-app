  "exportGate": {
    "description": "G71：全部 BLOCK 级 PC 项 PASS 才允许 T3 export",
    "requiredIds": ["PC-01", "PC-02", "PC-03", "PC-04", "PC-06", "PC-07", "PC-08", "PC-09", "PC-10", "PC-11", "PC-12", "PC-13", "PC-14"]
