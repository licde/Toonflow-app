    { "id": "AG-GATE-02", "rule": "motion 白名单；禁面部重写", "severity": "BLOCK", "rePushTarget": "EN", "related": ["QF-EXPR-06"] },
    { "id": "AG-GATE-03", "rule": "duration 1-30s", "severity": "BLOCK", "rePushTarget": "SB" },
